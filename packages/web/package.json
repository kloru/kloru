{
  "name": "@kloru/web",
  "version": "0.1.0",
  "private": true,
  "description": "Kloru console: connect apps, set what the agent may do, approve actions, manage contacts",
  "type": "module",
  "main": "./dist/main.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-editor.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.700.0",
    "@kloru/desk": "workspace:*",
    "@kloru/store": "workspace:*",
    "@kloru/core": "workspace:*",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@blocknote/core": "0.55.0",
    "@blocknote/mantine": "0.55.0",
    "@blocknote/react": "0.55.0",
    "@electric-sql/pglite": "0.2.17",
    "@mantine/core": "8.3.18",
    "@mantine/hooks": "8.3.18",
    "@types/node": "^22.15.0",
    "@types/pg": "8.11.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  }
}
