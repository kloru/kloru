# Your Kloru's keys. Copy this file to kloru.env (git-ignored) and fill it in.
# deploy/selfhost/setup.py reads it and stages every value as a Fly secret without printing it.
# SETUP.md says where to get each one. Never commit kloru.env, and never paste keys into a chat.

# --- Required -----------------------------------------------------------------------------

# Models (openrouter.ai → Keys). Every model Kloru uses goes through OpenRouter.
OPENROUTER_API_KEY=

# Phone calls and sign-in codes (twilio.com → Console). Verify is for the website's sign-in codes:
# Twilio console → Verify → Services → Create, then copy the service SID (starts with VA).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Hearing and speaking on calls: speech to text (deepgram.com) and text to speech (cartesia.ai).
# CARTESIA_VOICE_ID is the voice Kloru speaks with: pick one at play.cartesia.ai and copy its id.
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Texting by iMessage (inkbox.ai → Console → API keys). setup.py creates Kloru's identity.
INKBOX_API_KEY=

# Gmail, Google Calendar and other apps (composio.dev → Settings → API keys).
COMPOSIO_API_KEY=

# --- Optional -----------------------------------------------------------------------------

# Email from Kloru (resend.com): an API key, and a from address on a domain you verified there.
RESEND_API_KEY=
KLORU_MAIL_FROM=

# A cloud browser for booking and buying on websites (steel.dev → API keys). Without it, Kloru
# runs Chromium on its own machine, which some checkouts block.
STEEL_API_KEY=

# Paying with one-time cards from Stripe Link (Stripe's agent-spend program; you apply for access).
STRIPE_PUBLISHABLE_KEY=
LINK_CLIENT_ID=
LINK_CLIENT_SECRET=

# Traces of every call and task (cloud.langfuse.com → Settings → API keys).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Nightly encrypted backups to Cloudflare R2 (dash.cloudflare.com → R2 → Manage API tokens).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
